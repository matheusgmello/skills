{
  "root": ".",
  "maxFileLines": 300,
  "complexityRule": "complexity",
  "benchmarkTolerance": 10,
  "benchmarkUnit": "ms",
  "metrics": ["coverage", "duplication", "lint", "largeFiles", "complexity", "dependencies", "mutation", "benchmark", "security"],
  "includeExt": [".js", ".jsx", ".ts", ".tsx", ".java", ".py", ".rb"],
  "exclude": ["node_modules", ".git", "dist", "build", "target", "coverage"],
  "reports": {
    "coverage": "coverage/coverage-summary.json",
    "lint": "reports/eslint.json",
    "audit": "reports/npm-audit.json",
    "mutation": "reports/mutation/mutation.json",
    "benchmark": "reports/bench.json"
  },
  "summaryFile": "quality-gate-summary.md"
}
