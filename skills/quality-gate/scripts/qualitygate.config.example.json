{
  "root": ".",
  "maxFileLines": 300,
  "metrics": ["coverage", "duplication", "lint", "largeFiles", "security"],
  "includeExt": [".js", ".jsx", ".ts", ".tsx", ".java", ".py", ".rb"],
  "exclude": ["node_modules", ".git", "dist", "build", "target", "coverage"],
  "reports": {
    "coverage": "coverage/coverage-summary.json",
    "lint": "reports/eslint.json",
    "audit": "reports/npm-audit.json"
  },
  "summaryFile": "quality-gate-summary.md"
}
